{
  "name": "entertainment-web-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://GerardoCianciulli.github.io/Entertainment-web-app/",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch data.json --port 3000",
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:server\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "formik": "^2.4.9",
    "jquery": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "gh-pages": "^6.3.0",
    "json-server": "^0.17.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
